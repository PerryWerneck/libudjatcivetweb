msgid ""
"Invalid authentication engine configuration. Please check server settings."
msgstr ""
"A configuração do sistema de autenticação não é válida. Verifique a "
"configuração do servidor."

#: src/library/oauth2/callback.cc:104
msgid "Empty response from authentication server"
msgstr "Servidor de autenticação enviou uma resposta vazia"

#: src/library/oauth2/callback.cc:120
#, c++-format
msgid "Unexpected token type: '{}'"
msgstr "Tipo de token inválido: '{}'"

#: src/library/oauth2/callback.cc:143 src/library/oauth2/callback.cc:151
#: src/library/oauth2/callback.cc:159
msgid "Failed to retrieve information from the authentication server."
msgstr "Falha ao obter informações do servidor de autenticação."

#: src/library/oauth2/callback.cc:160
msgid "Empty token on authentication server response"
msgstr "Token vazio na resposta do servidor de autenticação"

#: src/library/oauth2/callback.cc:181
msgid "Configuration error"
msgstr "Erro de configuração"

#: src/library/oauth2/callback.cc:208
msgid "Error parsing authentication response"
msgstr "Erro ao processar resposta de autenticação"

#: src/library/oauth2/callback.cc:239
msgid "The authentication server did not provide a username."
msgstr "O servidor de autenticação não forneceu um nome de usuário."

#: src/library/oauth2/callback.cc:246
msgid ""
"Access unauthorized. Please contact your system administrator if you believe "
"this is an error."
msgstr ""
"Acesso negado. Contacte o administrador do sistema se você acredita que isso "
"é um erro."

#: src/library/oauth2/callback.cc:258
msgid "Failed to retrieve user information from the authentication server."
msgstr "Falha ao obter informações de usuário no servidor de autenticação."

#: src/library/oauth2/context.cc:87 src/library/oauth2/context.cc:92
msgid "Configuration Error"
msgstr "Erro de configuração"

#: src/library/oauth2/context.cc:87
msgid ""
"An authentication method has not been configured for this webpage. Please "
"reach out to the system administrator."
msgstr ""
"Um método de autenticação não foi configurado para essa página. Contacte o "
"administrador do sistema."

#: src/library/oauth2/context.cc:92
msgid ""
"Connection failed. The system authentication endpoint is undefined or "
"improperly configured."
msgstr ""
"Conexão falhou. O endpoint de autenticação não está definido ou configurado "
"errado."

#: src/library/oauth2/context.cc:165
msgid "Authorized use only. All activity is monitored for security."
